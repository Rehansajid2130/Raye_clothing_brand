{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/shop", "dest": "/shop.html" },
    { "src": "/product", "dest": "/product.html" },
    { "src": "/cart", "dest": "/cart.html" },
    { "src": "/checkout", "dest": "/checkout.html" },
    { "src": "/wishlist", "dest": "/wishlist.html" },
    { "src": "/journal", "dest": "/journal.html" },
    { "src": "/about", "dest": "/about.html" },
    { "src": "/account", "dest": "/account.html" },
    { "src": "/order", "dest": "/order.html" },
    { "src": "/help", "dest": "/help.html" },
    { "src": "/admin", "dest": "/admin.html" },
    {
      "src": "/images/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/images/$1"
    }
  ]
}

